# ==========================================
# 后端环境变量示例文件（请复制为 .env 或 .env.production）
# ==========================================

# 运行环境：development / production
GO_ENV=development
GIN_MODE=debug

# HTTP 服务配置
HOST=127.0.0.1
PORT=8080

# 站点/接口基础地址（用于生成链接、SEO等场景）
SITE_URL=http://localhost:3000
BASE_URL=http://127.0.0.1:8080

# JWT 配置（务必在生产环境替换为强随机值）
JWT_SECRET=please-change-me-in-production

# 后台配置加密密钥（用于加密存储 Cloudflare Global API Key 等敏感配置）
# 必须为 32 字节：可以直接填 32 位随机字符串，或填 base64/hex（解码后 32 bytes）
# 生成示例：openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# 邮件后台支持 SMTP / Resend / 阿里邮箱 API 开放平台。
# 阿里邮箱 AppID/Secret 建议在后台「邮件」页面保存，不要写死到代码。
# 如使用阿里邮箱 API，请确保应用已开启 Mail.Send.All 权限；
# 如开启“限制仅以下 IP 可调用”，需把后端服务器出口 IP 加入白名单。

# 图库上传图片压缩（服务端）
# MEDIA_MAX_DIM: 最大边长（像素），会等比缩放，默认 1440
# MEDIA_JPEG_QUALITY: JPEG 质量 1-100，默认 82
# MEDIA_PNG_COMPRESSION: PNG 压缩级别 0-3，默认 2
MEDIA_MAX_DIM=1440
MEDIA_JPEG_QUALITY=82
MEDIA_PNG_COMPRESSION=2

JWT_EXPIRES_HOURS=24
CUSTOMER_JWT_EXPIRES_HOURS=168

# 默认管理员账号（安全开关）
# - 生产环境建议：设置 SEED_DEFAULT_ADMIN=true + DEFAULT_ADMIN_PASSWORD，并在首次启动后关闭开关或保管好密码
# - 开发环境：不设置 SEED_DEFAULT_ADMIN 时默认会创建（密码兜底为 admin123）
SEED_DEFAULT_ADMIN=
RESET_DEFAULT_ADMIN_PASSWORD=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@vibocnc.com
DEFAULT_ADMIN_FULLNAME=System Administrator
DEFAULT_ADMIN_ROLE=admin
DEFAULT_ADMIN_PASSWORD=

# 数据库配置（MySQL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=fanuc_sales

# 是否自动迁移（生产环境建议配合备份谨慎开启）
# 设为 false 时，新版本上线前需手动执行 backend/migrations/ 中对应的 SQL。
DB_AUTO_MIGRATE=true

# CORS（可选，默认使用代码里的宽松策略）
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com
# CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
# CORS_HEADERS=Authorization,Content-Type
# 浏览器扩展来源：生产环境默认不允许任何 chrome-extension:// 来源，
# 如需允许请写明具体扩展 ID（而不是打开全量开关）：
# CORS_EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
# CORS_ALLOW_CHROME_EXTENSIONS=false

# 反向代理可信来源（用于正确识别客户端 IP，防止伪造 X-Forwarded-For）
# 留空 = 仅信任回环 + 内网网段（宿主 Nginx / Docker bridge）
# ⚠️ 生产建议显式收窄为本机/反代实际地址，并确保后端端口只绑定 127.0.0.1，
#    否则同网段内任何主机都能伪造单值 X-Forwarded-For 绕过 IP 限流。
# TRUSTED_PROXIES=203.0.113.10
# TRUSTED_PLATFORM 仅在源站不能直接被访问时设置：
#   cloudflare                  —— 使用 CF-Connecting-IP
#   X-Real-Client-IP            —— 其他 CDN 覆盖的真实客户端 IP 头名
# 注意：设置后 Go 端不再校验来源 IP，必须用防火墙把源站限制为只有 CDN 可访问。
# TRUSTED_PLATFORM=cloudflare
# 另：nginx 必须“覆盖”而非“追加”该头（proxy_set_header X-Forwarded-For $remote_addr;）

# 接口错误详情：生产环境请保持 false，内部错误只记录到服务端日志
# API_VERBOSE_ERRORS=false

# 认证 Cookie：生产环境启用 HTTPS 时建议设为 true
# AUTH_COOKIE_SECURE=false

# 分流限流（可选覆盖，单位：每分钟）
# RATE_LIMIT_CONTACT_PER_MINUTE=5
# RATE_LIMIT_CUSTOMER_LOGIN_PER_MINUTE=20
# RATE_LIMIT_ORDER_CREATE_PER_MINUTE=20

# 上传目录（可选，默认由代码或容器映射决定）
# UPLOAD_PATH=./uploads

# Large eBay JSON imports use resumable 5 MiB chunks and persist temporary
# files under UPLOAD_PATH/.imports/ebay-json. Keep UPLOAD_PATH on a durable
# volume in production so uploads survive container restarts.

# Resumable SKU image ZIP import limits (values are bytes except counts)
# SKU_IMAGE_ARCHIVE_MAX_BYTES=21474836480
# SKU_IMAGE_ARCHIVE_MAX_ENTRIES=200000
# SKU_IMAGE_ARCHIVE_MAX_ENTRY_BYTES=26214400
# SKU_IMAGE_ARCHIVE_MAX_EXPANDED_BYTES=107374182400
# SKU_IMAGE_ARCHIVE_MAX_IMAGES_PER_SKU=30
# SKU_IMAGE_ARCHIVE_UPLOAD_TTL_MINUTES=1440

# Optional comma/space/newline-separated external image hosts to preserve
# PRODUCT_IMAGE_TRUSTED_DOMAINS=cdn.example.com,images.example.org

# 列表分页（可选）
# MAX_PAGE_SIZE=100

# ==========================================
# ISR Revalidation (Next.js on-demand revalidation)
# ==========================================
# Frontend URL for triggering ISR revalidation
FRONTEND_URL=http://localhost:3000
# Must match REVALIDATE_SECRET in frontend .env
REVALIDATE_SECRET=your-revalidate-secret-here

# 商品搜索策略（可选）
# like（默认）= 历史行为，sku/name/description/part_number/model 的 %关键词% 子串匹配。
# fulltext = 使用 FULLTEXT 索引（需先执行
#   backend/migrations/20260910_add_product_search_fulltext.sql），
#   搜索更快但不是子串匹配语义，请先用真实关键词验证效果再启用。
# PRODUCT_SEARCH_MODE=like

# Admin AI assistant tool calling (optional)
# 默认开启：AI 助手通过只读工具（search_products / get_product /
# list_categories / count_products / seo_gap_report）自行检索目录，
# 而不是依赖服务端猜测的目录快照。
# 若使用的 provider 不接受 tools 字段（404/501/422，或 400 且提示
# tools/function 不受支持），后端会自动降级为原来的单次请求，并按
# baseURL|model 记住，不会重复失败。
# 设为 false / 0 / off 可完全关闭工具调用。
# AI_AGENT_TOOLS=true

# AI_AGENT_TOOLS=true

# 分类发布置信度阈值（可选）
# 只有置信度 >= 该值的 AI 分类结果才会直接写入产品分类并发布；
# 低于该值但 >= 0.6 的结果会进入"分类复核队列"（管理端 → AI 助手），
# 由管理员一键采纳或丢弃，而不是被静默丢弃。
# 取值范围 (0,1]，非法值回落到默认 0.9。
# AI_CLASSIFICATION_MIN_CONFIDENCE=0.9
